{
  "$schema": "https://raw.githubusercontent.com/jiying2007/codex-safe-core/ca8770aa784306d27d306a2b1e4db2b090087de0/codex-safe.schema.json",
  "schemaVersion": 3,
  "commit": { "language": "zh-CN", "scopePolicy": "flexible", "autoInferScope": true, "styleHistoryLimit": 12 },
  "review": {
    "language": "zh-CN",
    "severityThreshold": "low",
    "confidenceThreshold": 0.7,
    "maxFindings": 40,
    "rules": {
      "requireTestsForCodeChanges": false,
      "codePathPrefixes": ["src/"],
      "testPathPrefixes": ["test/", "tests/"],
      "forbiddenPathPrefixes": []
    }
  },
  "reviewService": { "maxContextBytes": 262144, "maxContextFiles": 12, "contextLines": 20, "skipGeneratedFiles": true, "blockUnreviewableFiles": false },
  "pr": { "language": "zh-CN", "includePullRequestTemplate": true }
}
