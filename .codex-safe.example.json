{
  "$schema": "https://raw.githubusercontent.com/jiying2007/codex-safe-core/f4544a302c5053cf0a41e30944933554825e8ecc/codex-safe.schema.json",
  "schemaVersion": 3,
  "commit": {
    "language": "zh-CN",
    "scopePolicy": "flexible",
    "autoInferScope": true,
    "styleHistoryLimit": 12
  },
  "review": {
    "language": "zh-CN",
    "severityThreshold": "low",
    "confidenceThreshold": 0.7,
    "maxFindings": 40,
    "rules": {
      "requireTestsForCodeChanges": false,
      "codePathPrefixes": [
        "src/"
      ],
      "testPathPrefixes": [
        "test/",
        "tests/"
      ],
      "forbiddenPathPrefixes": []
    }
  },
  "reviewService": {
    "maxContextBytes": 262144,
    "maxContextFiles": 12,
    "contextLines": 20,
    "skipGeneratedFiles": true,
    "blockUnreviewableFiles": false
  }
}
