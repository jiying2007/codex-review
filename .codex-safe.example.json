{
  "$schema": "https://raw.githubusercontent.com/jiying2007/codex-safe-core/cd9788f1280a217fbe6d0beb59682a85a8b82c4d/codex-safe.schema.json",
  "schemaVersion": 4,
  "commit": {
    "language": "zh-CN",
    "scopePolicy": "flexible",
    "autoInferScope": true,
    "styleHistoryLimit": 12
  },
  "review": {
    "language": "zh-CN",
    "severityThreshold": "low",
    "confidenceThreshold": 0.7,
    "maxFindings": 40,
    "rules": {
      "requireTestsForCodeChanges": false,
      "codePathPrefixes": ["src/"],
      "testPathPrefixes": ["test/", "tests/"],
      "forbiddenPathPrefixes": []
    }
  },
  "change": {},
  "reviewService": {
    "maxContextBytes": 262144,
    "maxContextFiles": 12,
    "contextLines": 20,
    "skipGeneratedFiles": true,
    "blockUnreviewableFiles": false
  }
}
