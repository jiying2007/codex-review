{
  "name": "codex-review-safe",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "4.4.2",
  "publisher": "jiying2007",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "review",
    "code review",
    "codex",
    "source control",
    "diagnostics",
    "staged",
    "ai",
    "scm",
    "safe"
  ],
  "activationEvents": [
    "onCommand:safeCodexReview.reviewStaged",
    "onCommand:safeCodexReview.clearReview",
    "onCommand:safeCodexReview.checkEnvironment",
    "onCommand:safeCodexReview.showOutput",
    "onCommand:safeCodexReview.importSarif",
    "onCommand:safeCodexReview.generateFix",
    "onCommand:safeCodexReview.independentReviewStaged",
    "onCommand:safeCodexReview.resolveFinding",
    "onCommand:safeCodexReview.clearFindingResolutions"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capability.untrusted%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capability.virtual%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "safeCodexReview.reviewStaged",
        "title": "%command.review.title%",
        "category": "%extension.displayName%",
        "icon": "$(shield)"
      },
      {
        "command": "safeCodexReview.clearReview",
        "title": "%command.clear.title%",
        "category": "%extension.displayName%",
        "icon": "$(clear-all)"
      },
      {
        "command": "safeCodexReview.showOutput",
        "title": "%command.showOutput.title%",
        "category": "%extension.displayName%"
      },
      {
        "command": "safeCodexReview.checkEnvironment",
        "title": "%command.checkEnvironment.title%",
        "category": "%extension.displayName%"
      },
      {
        "command": "safeCodexReview.importSarif",
        "title": "%command.importSarif.title%",
        "category": "%extension.displayName%",
        "icon": "$(file-code)"
      },
      {
        "command": "safeCodexReview.generateFix",
        "title": "%command.generateFix.title%",
        "category": "%extension.displayName%",
        "icon": "$(tools)"
      },
      {
        "command": "safeCodexReview.independentReviewStaged",
        "title": "%command.independentReview.title%",
        "category": "%extension.displayName%",
        "icon": "$(sync)"
      },
      {
        "command": "safeCodexReview.resolveFinding",
        "title": "%command.resolveFinding.title%",
        "category": "%extension.displayName%",
        "icon": "$(feedback)"
      },
      {
        "command": "safeCodexReview.clearFindingResolutions",
        "title": "%command.clearResolutions.title%",
        "category": "%extension.displayName%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "safeCodexReview.reviewStaged",
          "when": "scmProvider == git && isWorkspaceTrusted",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "safeCodexReview.reviewStaged",
          "when": "workspaceFolderCount > 0 && isWorkspaceTrusted"
        },
        {
          "command": "safeCodexReview.clearReview"
        },
        {
          "command": "safeCodexReview.showOutput"
        },
        {
          "command": "safeCodexReview.checkEnvironment",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "safeCodexReview.importSarif",
          "when": "workspaceFolderCount > 0 && isWorkspaceTrusted"
        },
        {
          "command": "safeCodexReview.generateFix",
          "when": "workspaceFolderCount > 0 && isWorkspaceTrusted"
        },
        {
          "command": "safeCodexReview.independentReviewStaged",
          "when": "workspaceFolderCount > 0 && isWorkspaceTrusted"
        },
        {
          "command": "safeCodexReview.resolveFinding",
          "when": "workspaceFolderCount > 0 && isWorkspaceTrusted"
        },
        {
          "command": "safeCodexReview.clearFindingResolutions",
          "when": "workspaceFolderCount > 0 && isWorkspaceTrusted"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".codex-safe.json",
        "url": "./dist/codex-safe.schema.json"
      }
    ],
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "safeCodexReview.codexPath": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "description": "%config.codexPath%"
        },
        "safeCodexReview.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.model%"
        },
        "safeCodexReview.providerMode": {
          "type": "string",
          "enum": [
            "openai",
            "openai-compatible"
          ],
          "default": "openai",
          "scope": "application",
          "description": "Codex provider runtime: built-in OpenAI or an explicitly configured OpenAI-compatible Responses endpoint."
        },
        "safeCodexReview.providerBaseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "HTTPS base URL for openai-compatible mode. User Codex config.toml is intentionally ignored."
        },
        "safeCodexReview.providerApiKeyEnv": {
          "type": "string",
          "default": "OPENAI_API_KEY",
          "scope": "application",
          "description": "Environment-variable name containing the provider API key. The secret value is never stored in VS Code settings."
        },
        "safeCodexReview.connectTimeoutSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 120,
          "scope": "application",
          "description": "Provider connection timeout in seconds."
        },
        "safeCodexReview.requestTimeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 900,
          "scope": "application",
          "description": "Maximum time for one Codex model request."
        },
        "safeCodexReview.reviewTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 30,
          "maximum": 1800,
          "scope": "application",
          "description": "Whole Review operation deadline across hypothesis and verification requests."
        },
        "safeCodexReview.streamIdleTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "scope": "application",
          "description": "Maximum idle time for a provider response stream."
        },
        "safeCodexReview.language": {
          "type": "string",
          "enum": [
            "zh-CN",
            "en"
          ],
          "default": "zh-CN",
          "scope": "application",
          "description": "%config.language%",
          "enumDescriptions": [
            "%config.language.zhCN%",
            "%config.language.en%"
          ]
        },
        "safeCodexReview.profile": {
          "type": "string",
          "enum": [
            "quick",
            "standard",
            "deep",
            "security",
            "embedded"
          ],
          "default": "standard",
          "scope": "application",
          "description": "%config.profile%",
          "enumDescriptions": [
            "%config.profile.quick%",
            "%config.profile.standard%",
            "%config.profile.deep%",
            "%config.profile.security%",
            "%config.profile.embedded%"
          ]
        },
        "safeCodexReview.sarifFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 8,
          "default": [],
          "scope": "application",
          "description": "%config.sarifFiles%"
        },
        "safeCodexReview.maxDiffBytes": {
          "type": "number",
          "default": 524288,
          "minimum": 4096,
          "maximum": 2097152,
          "scope": "application",
          "description": "%config.maxDiffBytes%"
        },
        "safeCodexReview.maxFindings": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 100,
          "scope": "application",
          "description": "%config.maxFindings%"
        },
        "safeCodexReview.severityThreshold": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "default": "low",
          "scope": "application",
          "description": "%config.severityThreshold%"
        },
        "safeCodexReview.confidenceThreshold": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "scope": "application",
          "description": "%config.confidenceThreshold%"
        },
        "safeCodexReview.extraInstructions": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.extraInstructions%"
        }
      }
    }
  },
  "scripts": {
    "core:init": "git submodule update --init --recursive",
    "precheck": "npm run core:init",
    "pretest": "npm run core:init",
    "prebuild": "npm run core:init",
    "prepackage": "npm run core:init",
    "build": "node scripts/build.js",
    "check": "node --check extension.js && node --check test/trust/runTest.js && node --check test/trust/suite/index.js && node --check src/i18n.js && node --check src/review-support.js && node --check src/process.js && node --check src/git.js && node --check src/policy.js && node --check src/review.js && node --check src/report.js && node --check src/receipts.js && node --check src/codex.js && node --check src/quality.js && node --check src/codex-safe-core/safe-contract.js && node --check src/codex-safe-core/codex-cli.js && node --check src/codex-safe-core/process-runner.js && node --check src/codex-safe-core/git-repository.js && node --check src/codex-safe-core/context-builder.js && node --check src/codex-safe-core/efficiency-planner.js && node --check src/codex-safe-core/quality-platform.js && node --check src/codex-safe-core/policy.js && node --check src/codex-safe-core/review-rules.js && node --check scripts/build.js && node --check scripts/release.js && node --check scripts/verify-security-manifest.js && node --check scripts/verify-module-boundaries.js && node --check src/semantic-evidence.js && node --check src/semantic-review.js && node --check src/review-cache.js && node --check src/finding-ledger.js && node --check src/code-intelligence.js && node --check src/codex-safe-core/semantic-review.js && node --check src/review-scope.js && node --check src/review-lineage.js && node --check src/convergence.js && node --check src/causal-anchor.js && node scripts/release.test.js && node scripts/verify-security-manifest.js && node scripts/verify-module-boundaries.js && node src/codex-safe-core/scripts/verify-family-ui-contract.js . && npm run governance && npm run verify:l10n && node test.js && node test/quality-platform.test.js && node test/semantic-platform.test.js && node test/review-cache.test.js && node test/review-lineage.test.js && node test/causal-scope.test.js && node test/semantic-corpus.test.js && npm run build",
    "test:unit": "node test.js && node test/quality-platform.test.js && node test/semantic-platform.test.js && node test/review-cache.test.js && node test/review-lineage.test.js && node test/causal-scope.test.js && node test/semantic-corpus.test.js",
    "test:integration": "npm run build && node ./test/integration/runTest.js",
    "test:trust": "npm run build && node ./test/trust/runTest.js",
    "test": "npm run test:unit",
    "package": "npm run build && vsce package --no-dependencies",
    "verify:lock": "node ./scripts/verify-lock.js",
    "release:prepare": "node ./scripts/release.js prepare",
    "release:check": "node ./scripts/release.js check",
    "release:push": "node ./scripts/release.js push",
    "ci": "npm run verify:lock && npm ci --ignore-scripts --no-audit --no-fund && npm run check && npm run test:integration && npm run test:trust && npm run package",
    "verify:l10n": "node ./scripts/verify-l10n.js",
    "governance": "node src/codex-safe-core/scripts/verify-actions-pins.js .github/workflows && node src/codex-safe-core/scripts/verify-non-goals.js .",
    "diagnostics": "node src/codex-safe-core/scripts/family-diagnostics.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jiying2007/codex-review.git"
  },
  "homepage": "https://github.com/jiying2007/codex-review#readme",
  "bugs": {
    "url": "https://github.com/jiying2007/codex-review/issues"
  },
  "pricing": "Free",
  "preview": false,
  "icon": "images/icon.png",
  "l10n": "./l10n"
}
